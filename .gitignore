# ---------- 虚拟环境与缓存 ----------
.venv/
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 密钥与本地配置 ----------
# .env 存真实密钥（DeepSeek / PushPlus），绝不入库；.env.example 是模板，要入库
.env

# ---------- 数据库与备份（含完整生产数据，绝不入库）----------
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.bak-*
data/backup/

# ---------- 浏览器登录态与 cookie ----------
# 闲鱼/B站/NGA 的登录凭据，属个人敏感信息
data/browser_profile/
data/cookies*.json
data/goofish_*.html

# ---------- 运行产物 ----------
logs/
reports/
backup/

# ---------- 二进制文档 ----------
# 默认忽略表格，但 docs/ 下的核查清单是交付物，允许入库
*.xlsx
!docs/*.xlsx

# ---------- 本地文档 ----------
# 需求与设计、整改报告只在本地留存，不入库（需要时从 git 历史取）
docs/
